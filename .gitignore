# 1. ENVIRONMENT VARIABLES AND SECRETS
# --------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example

# Credentials and private directories
secrets/
credentials/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Credential files
credentials.json
service-account*.json

# ESP32 private configuration
config_secrets.h
wifi_credentials.h
secrets.h

# Allow safe example configuration files
!config_secrets.example.h
!wifi_credentials.example.h


